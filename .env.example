APP_PASSWORD=isi-password-login
APP_SECRET=isi-string-acak-panjang
JOBS_DIR=jobs
CLAUDE_MODEL=opus
# Folder induk repo Git di server yang boleh dipilih di form (pisahkan dengan titik dua). Kosong: sumber Git ditolak.
GIT_ROOTS=/home/user/git
# 0 = lewati hitung ulang rumus lewat LibreOffice (job lebih cepat; Excel tetap menghitung saat file dibuka).
RECALC=1
